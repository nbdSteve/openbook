{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteTheStackLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:111111111111:log-group:Openbook-prod-*",
        "arn:aws:logs:ap-southeast-2:111111111111:log-group:Openbook-prod-*:*",
        "arn:aws:logs:ap-southeast-2:111111111111:log-group:/aws/lambda/Openbook-prod-*",
        "arn:aws:logs:ap-southeast-2:111111111111:log-group:/aws/lambda/Openbook-prod-*:*"
      ]
    },
    {
      "Sid": "CreateTheLambdaLogGroups",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": [
        "arn:aws:logs:ap-southeast-2:111111111111:log-group:Openbook-prod-*",
        "arn:aws:logs:ap-southeast-2:111111111111:log-group:/aws/lambda/Openbook-prod-*"
      ]
    },
    {
      "Sid": "UseTheApplicationTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DeleteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-2:111111111111:table/Openbook-prod-*",
        "arn:aws:dynamodb:ap-southeast-2:111111111111:table/Openbook-prod-*/index/*"
      ]
    },
    {
      "Sid": "UseTheStackBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:Abort*",
        "s3:DeleteObject*",
        "s3:GetBucket*",
        "s3:GetObject*",
        "s3:List*",
        "s3:PutObject*"
      ],
      "Resource": [
        "arn:aws:s3:::openbook-prod-*",
        "arn:aws:s3:::openbook-prod-*/*"
      ]
    },
    {
      "Sid": "ReadTheStackAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:GetObject*",
        "s3:List*"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-111111111111-ap-southeast-2",
        "arn:aws:s3:::cdk-hnb659fds-assets-111111111111-ap-southeast-2/openbook-prod/*"
      ]
    },
    {
      "Sid": "SendAndConsumeIngestMessages",
      "Effect": "Allow",
      "Action": [
        "sqs:ChangeMessageVisibility",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ReceiveMessage",
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:sqs:ap-southeast-2:111111111111:Openbook-prod-ingest.fifo"
    },
    {
      "Sid": "CreateTheCourseVectorIndexes",
      "Effect": "Allow",
      "Action": "s3vectors:CreateIndex",
      "Resource": "arn:aws:s3vectors:ap-southeast-2:111111111111:bucket/openbook-prod-vectors"
    },
    {
      "Sid": "UseTheCourseVectorIndexes",
      "Effect": "Allow",
      "Action": [
        "s3vectors:DeleteIndex",
        "s3vectors:DeleteVectors",
        "s3vectors:GetIndex",
        "s3vectors:GetVectors",
        "s3vectors:PutVectors",
        "s3vectors:QueryVectors"
      ],
      "Resource": "arn:aws:s3vectors:ap-southeast-2:111111111111:bucket/openbook-prod-vectors/index/*"
    },
    {
      "Sid": "InvokeBedrockModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:ap-southeast-2::foundation-model/amazon.titan-embed-text-v2:0",
        "arn:aws:bedrock:ap-southeast-2:111111111111:inference-profile/au.anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:ap-southeast-2::foundation-model/anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:ap-southeast-4::foundation-model/anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:ap-southeast-2:111111111111:inference-profile/au.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:ap-southeast-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:ap-southeast-4::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:ap-southeast-2::foundation-model/openai.gpt-oss-120b-1:0"
      ]
    },
    {
      "Sid": "InvalidateTheSite",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::111111111111:distribution/*"
    }
  ]
}
