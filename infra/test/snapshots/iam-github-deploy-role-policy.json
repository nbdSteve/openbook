{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployTheOpenbookProdStackAndNoOther",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:RollbackStack",
        "cloudformation:ContinueUpdateRollback",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:GetTemplate",
        "cloudformation:UpdateTerminationProtection"
      ],
      "Resource": "arn:aws:cloudformation:ap-southeast-2:111111111111:stack/Openbook-prod/*"
    },
    {
      "Sid": "NeverImportExistingResourcesIntoTheStack",
      "Effect": "Deny",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudformation:ChangeSetType": "IMPORT"
        }
      }
    },
    {
      "Sid": "CloudFormationCallsThatTakeNoResource",
      "Effect": "Allow",
      "Action": [
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStacks",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PublishCdkAssetsUnderTheOpenbookProdPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:Abort*",
        "s3:GetObject*",
        "s3:PutObject*"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-111111111111-ap-southeast-2/openbook-prod/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "111111111111"
        }
      }
    },
    {
      "Sid": "ReadTheBootstrapBucketAndListOnlyTheOpenbookProdPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-111111111111-ap-southeast-2",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "111111111111"
        }
      }
    },
    {
      "Sid": "ListOnlyTheOpenbookProdPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-111111111111-ap-southeast-2",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "111111111111"
        },
        "StringLike": {
          "s3:prefix": [
            "openbook-prod/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadTheBootstrapVersion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-2:111111111111:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "PassOnlyTheOpenbookExecutionRoleAndOnlyToCloudFormation",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111111111111:role/ExampleOpenbookExecutionRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
