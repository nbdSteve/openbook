{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApplicationTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeContributorInsights",
        "dynamodb:DescribeKinesisStreamingDestination",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateContributorInsights",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-2:${ACCOUNT_ID}:table/Openbook-prod-*",
        "arn:aws:dynamodb:ap-southeast-2:${ACCOUNT_ID}:table/Openbook-prod-*/index/*"
      ]
    },
    {
      "Sid": "LambdaFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:DeleteFunctionConcurrency",
        "lambda:DeleteFunctionUrlConfig",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionUrlConfig",
        "lambda:GetPolicy",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListTags",
        "lambda:PutFunctionConcurrency",
        "lambda:PutRuntimeManagementConfig",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:function:Openbook-prod-*",
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:function:Openbook-prod-*:*"
      ]
    },
    {
      "Sid": "AddOnlyCloudFrontInvokePermissions",
      "Effect": "Allow",
      "Action": "lambda:AddPermission",
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:function:Openbook-prod-*",
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:function:Openbook-prod-*:*"
      ],
      "Condition": {
        "StringEquals": {
          "lambda:Principal": "cloudfront.amazonaws.com"
        }
      }
    },
    {
      "Sid": "FunctionUrlsOnlyWithIamAuth",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:function:Openbook-prod-*",
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:function:Openbook-prod-*:*"
      ],
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "AWS_IAM"
        }
      }
    },
    {
      "Sid": "InvokeTheBucketDeploymentProvider",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:function:Openbook-prod-CustomCDKBucketDeployment*"
    },
    {
      "Sid": "BucketDeploymentLayers",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteLayerVersion",
        "lambda:GetLayerVersion",
        "lambda:GetLayerVersionPolicy",
        "lambda:PublishLayerVersion"
      ],
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:layer:OpenbookDeployAssetsAwsCliLayer*",
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:layer:OpenbookDeployAssetsAwsCliLayer*:*",
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:layer:OpenbookDeployEntryAwsCliLayer*",
        "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:layer:OpenbookDeployEntryAwsCliLayer*:*"
      ]
    },
    {
      "Sid": "ReadAndTidyTheStackRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/Openbook-prod-*"
    },
    {
      "Sid": "CreateOrChangeStackRolesOnlyWithTheBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/Openbook-prod-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${ACCOUNT_ID}:policy/OpenbookProdPermissionsBoundary"
        }
      }
    },
    {
      "Sid": "AttachOnlyTheLambdaBasicExecutionPolicyAndOnlyWithTheBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/Openbook-prod-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        },
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${ACCOUNT_ID}:policy/OpenbookProdPermissionsBoundary"
        }
      }
    },
    {
      "Sid": "NeverRemoveTheBoundary",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    },
    {
      "Sid": "PassTheStackRolesToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/Openbook-prod-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "IngestQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": "arn:aws:sqs:ap-southeast-2:${ACCOUNT_ID}:Openbook-prod-ingest*"
    },
    {
      "Sid": "IngestEventSourceMappingOfTheStackFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:event-source-mapping:*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:ap-southeast-2:${ACCOUNT_ID}:function:Openbook-prod-*"
        }
      }
    },
    {
      "Sid": "VectorBucket",
      "Effect": "Allow",
      "Action": [
        "s3vectors:CreateVectorBucket",
        "s3vectors:DeleteVectorBucket",
        "s3vectors:GetVectorBucket",
        "s3vectors:ListTagsForResource",
        "s3vectors:TagResource",
        "s3vectors:UntagResource"
      ],
      "Resource": "arn:aws:s3vectors:ap-southeast-2:${ACCOUNT_ID}:bucket/openbook-prod-*"
    },
    {
      "Sid": "StackLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:${ACCOUNT_ID}:log-group:Openbook-prod-*",
        "arn:aws:logs:ap-southeast-2:${ACCOUNT_ID}:log-group:Openbook-prod-*:*"
      ]
    },
    {
      "Sid": "DescribeLogGroupsTakesTheWholeRegion",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:logs:ap-southeast-2:${ACCOUNT_ID}:log-group:*"
    },
    {
      "Sid": "StackBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteBucketCors",
        "s3:DeleteBucketPolicy",
        "s3:DeleteLifecycleConfiguration",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:PutBucketCORS",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::openbook-prod-*"
    },
    {
      "Sid": "UserPoolCreateTakesNoResource",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*"
    },
    {
      "Sid": "UserPoolAndClient",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:GetUserPoolMfaConfig",
        "cognito-idp:ListTagsForResource",
        "cognito-idp:ListUserPoolClientSecrets",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:UpdateUserPoolClient"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-2:${ACCOUNT_ID}:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/aws:cloudformation:stack-name": "Openbook-prod"
        }
      }
    },
    {
      "Sid": "CloudFrontSite",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateDistributionWithTags",
        "cloudfront:CreateFunction",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:CreateResponseHeadersPolicy",
        "cloudfront:DeleteDistribution",
        "cloudfront:DeleteOriginAccessControl",
        "cloudfront:DeleteResponseHeadersPolicy",
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetResponseHeadersPolicy",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:UpdateDistribution",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:UpdateResponseHeadersPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFrontSpaRewriteFunction",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DeleteFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction",
        "cloudfront:PublishFunction",
        "cloudfront:UpdateFunction"
      ],
      "Resource": "arn:aws:cloudfront::${ACCOUNT_ID}:function/Openbook-prod-SpaRewrite"
    },
    {
      "Sid": "ReadTheStackAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-${ACCOUNT_ID}-ap-southeast-2/openbook-prod/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${ACCOUNT_ID}"
        }
      }
    },
    {
      "Sid": "ReadTheBootstrapVersion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-2:${ACCOUNT_ID}:parameter/cdk-bootstrap/hnb659fds/version"
    }
  ]
}
