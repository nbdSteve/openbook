{
  "app": "npx tsx bin/openbook.ts",
  "output": "cdk.out",
  "watch": {
    "include": [
      "bin/**",
      "lib/**"
    ],
    "exclude": [
      "node_modules/**",
      "cdk.out/**",
      "dist/**",
      "test/**"
    ]
  },
  "context": {
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:target-partitions": [
      "aws"
    ],
    "models": [
      {
        "id": "claude-sonnet",
        "label": "Claude Sonnet 4.6",
        "vendor": "anthropic",
        "provider": "bedrock",
        "modelId": "au.anthropic.claude-sonnet-4-6",
        "residency": "au",
        "maxOutputTokens": 2000,
        "vision": true,
        "inputUsdPerMillion": 3.3,
        "outputUsdPerMillion": 16.5
      },
      {
        "id": "claude-haiku",
        "label": "Claude Haiku 4.5",
        "vendor": "anthropic",
        "provider": "bedrock",
        "modelId": "au.anthropic.claude-haiku-4-5-20251001-v1:0",
        "residency": "au",
        "maxOutputTokens": 2000,
        "vision": true,
        "inputUsdPerMillion": 1.1,
        "outputUsdPerMillion": 5.5
      },
      {
        "id": "gpt-oss-120b",
        "label": "gpt-oss-120b",
        "vendor": "openai",
        "provider": "bedrock",
        "modelId": "openai.gpt-oss-120b-1:0",
        "residency": "au",
        "maxOutputTokens": 2000,
        "vision": false,
        "inputUsdPerMillion": 0.1545,
        "outputUsdPerMillion": 0.618
      }
    ],
    "defaultChatModel": "claude-sonnet",
    "fastModel": "claude-haiku",
    "stageDomains": {
      "prod": {
        "domainName": "openbook.steve.gg",
        "hostedZoneName": "steve.gg",
        "redirects": [
          {
            "host": "ask.steve.gg",
            "path": "/",
            "keepPath": true,
            "recordIdPrefix": "Alias"
          },
          {
            "host": "portal.steve.gg",
            "path": "/portal"
          }
        ]
      }
    },
    "stageLimits": {
      "dev": {
        "limitDailyMessagesGlobal": 100,
        "limitDailyTokensGlobal": 500000,
        "limitDailyTranscribedPagesGlobal": 100
      },
      "prod": {
        "limitDailyMessagesGlobal": 300,
        "limitDailyTokensGlobal": 1500000,
        "limitDailyTranscribedPagesGlobal": 300
      }
    },
    "stageDemo": {
      "dev": {
        "enabled": true,
        "budgetUsdPerDay": 2,
        "visitorBudgetUsdPerDay": 0.3,
        "maxOutputTokens": 1000,
        "concurrency": 2
      },
      "prod": {
        "enabled": true,
        "budgetUsdPerDay": 2,
        "visitorBudgetUsdPerDay": 0.3,
        "maxOutputTokens": 1000,
        "concurrency": 3
      }
    },
    "embeddingModelId": "amazon.titan-embed-text-v2:0"
  },
  "cli-telemetry": false
}
